APP_NAME=creditflow-scraper-service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8110
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=creditflow_scraper
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
JWT_PUBLIC_KEY_PATH=../keys/public_key.pem
JWT_PUBLIC_KEY=
JWT_ISSUER=creditflow-auth
JWT_AUDIENCE=creditflow-api
INTERNAL_SERVICE_TOKEN=
FRONTEND_URL=http://localhost:3000
SCRAPER_ENGINE=httpx
SCRAPER_USER_AGENT=CreditFlowBot/1.0 (+https://creditflow.example/bot)
REQUEST_TIMEOUT_SECONDS=20
ROBOTS_CACHE_SECONDS=3600
MIN_REQUEST_INTERVAL_SECONDS=2
MAX_PAGES_PER_JOB=10
MAX_DOCUMENT_CHARS=20000
SERPAPI_API_KEY=
SERPAPI_BASE_URL=https://serpapi.com/search
SERPAPI_ENGINE=google
RECURRING_SCAN_INTERVAL_SECONDS=60
PUBLISH_MAX_ATTEMPTS=5
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
