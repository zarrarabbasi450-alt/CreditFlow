APP_NAME=creditflow-usage-service
APP_HOST=0.0.0.0
APP_PORT=8005
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/creditflow
DATABASE_SCHEMA=usage
