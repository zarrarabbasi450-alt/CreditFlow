APP_NAME=creditflow-scheduler-service
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8108
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/creditflow
DATABASE_SCHEMA=scheduler
REDIS_URL=redis://localhost:6379/4
CELERY_BROKER_URL=redis://localhost:6379/4
CELERY_RESULT_BACKEND=redis://localhost:6379/4
RABBITMQ_URL=amqp://guest:guest@localhost:5672/
JWT_PUBLIC_KEY_PATH=../keys/public_key.pem
JWT_PUBLIC_KEY=
JWT_ISSUER=creditflow-auth
JWT_AUDIENCE=creditflow-api
DUE_SCAN_INTERVAL_SECONDS=60
SCHEDULE_LOCK_TTL_SECONDS=120
TRUSTED_HOSTS=localhost,127.0.0.1,testserver
